NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crmpro
REDIS_URL=redis://localhost:6379
# Or configure Redis explicitly:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

BULL_PREFIX=crmpro
# BULL_IMPORT_CONCURRENCY=3
# BULL_EXPORT_CONCURRENCY=2
# BULL_CLEANUP_CONCURRENCY=1
# BULL_JOB_ATTEMPTS=3
# BULL_JOB_BACKOFF_DELAY_MS=3000

# Cleanup workers
# UPLOAD_INTENT_TTL_MINUTES=60
# IMPORT_JOB_TIMEOUT_MINUTES=15
# EXPORT_JOB_TIMEOUT_MINUTES=15
# SESSION_RETENTION_DAYS=30
# CLEANUP_BATCH_SIZE=500
# CLEANUP_UPLOAD_INTENTS_INTERVAL_MS=3600000
# CLEANUP_STALE_JOBS_INTERVAL_MS=900000
# CLEANUP_SESSIONS_INTERVAL_MS=86400000
# CLEANUP_ORPHAN_S3_CRON=0 3 * * *

# Observability
# LOG_LEVEL=info
# ENABLE_HTTP_LOGGING=true
# ENABLE_WORKER_LOGGING=true
# ENABLE_QUERY_LOGGING=true
# ENABLE_STORAGE_LOGGING=true
# ENABLE_AUTH_LOGGING=true
# SLOW_QUERY_THRESHOLD_MS=250
# API_VERSION=1.0.0
# Shared secret for platform admin-api to read jobs/metrics snapshot
# INTERNAL_MONITORING_KEY=change-me-to-a-long-random-string
# ANALYTICS_CACHE_TTL_SECONDS=300
# NOTIFICATION_UNREAD_TTL_SECONDS=60
# BULL_NOTIFICATION_CONCURRENCY=5
# TASK_CACHE_TTL_SECONDS=300

# Must be at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Comma-separated allowed origins for CORS.
# Required in production (startup fails without it). In development it falls back to local origins.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Set to true to serve Swagger UI (defaults off in production)
# ENABLE_SWAGGER=false
# Set to true only when the refresh cookie must cross origin (requires Secure + SameSite=None)
# REFRESH_COOKIE_CROSS_ORIGIN=false

# Set true only when the browser calls the API on a different origin in production
# (requires HTTPS). Prefer same-origin proxy via the Next.js app instead.
# REFRESH_COOKIE_CROSS_ORIGIN=false

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=crmpro-dev-assets
# AWS_S3_ENDPOINT=http://localhost:9000
