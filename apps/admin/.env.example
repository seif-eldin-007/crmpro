# Same-origin API path (proxied to admin-api via next.config rewrites).
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:3100
NEXT_PUBLIC_APP_ENV=development

# Realtime (socket.io) gateway origin. The Next rewrite proxies only /api/*, not
# /socket.io/*, so this must be an absolute origin the browser can reach directly.
# In production, set it to the admin-api origin (e.g. https://admin-api.example.com).
# It may be left unset ONLY if a reverse proxy routes /socket.io to the API on the
# same origin.
NEXT_PUBLIC_SSE_URL=http://localhost:3100
