NODE_ENV=development
PORT=3100

DATABASE_URL=
REDIS_URL=

# Tenant CRM API (used for System health probes + optional metrics snapshot)
TENANT_API_URL=http://localhost:3000/api/v1
# Must match apps/api INTERNAL_MONITORING_KEY to pull queues/workers/HTTP metrics
# INTERNAL_MONITORING_KEY=change-me-to-a-long-random-string
# STUCK_JOB_TIMEOUT_MINUTES=15

# Must be at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m

# Must be at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=30d

# Comma-separated allowed origins for CORS.
# Required in production (startup fails without it). In development it falls back to local origins.
# CORS_ORIGINS=http://localhost:3002
# Set to true only when the refresh cookie must cross origin (requires Secure + SameSite=None)
# REFRESH_COOKIE_CROSS_ORIGIN=false
