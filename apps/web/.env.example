# Same-origin API path (proxied to Nest via next.config rewrites).
# Do not point the browser at http://localhost:3000 — cross-port cookies are unreliable.
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Realtime (socket.io) gateway origin. The Next rewrite proxies only /api/*, not
# /socket.io/*, so this must be an absolute origin the browser can reach directly.
# In production, set it to the API origin (e.g. https://api.example.com). It may be
# left unset ONLY if a reverse proxy routes /socket.io to the API on the same origin.
NEXT_PUBLIC_SSE_URL=http://localhost:3000
